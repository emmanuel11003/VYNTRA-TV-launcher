<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SettingsRow"
    android:layout_marginTop="12dp"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/animTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFE3E2E6"
            android:textSize="17sp"
            android:duplicateParentState="true" />

        <TextView
            android:id="@+id/animSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFC4C6D0"
            android:textSize="13sp"
            android:duplicateParentState="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/animBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="64dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold"
        android:text="@string/switch_on_badge"
        android:textColor="#FFE3E2E6"
        android:background="@drawable/switch_on_bg"
        android:duplicateParentState="true" />
</LinearLayout>
